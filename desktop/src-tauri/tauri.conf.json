{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Voice Agent",
  "version": "0.1.0",
  "identifier": "com.enfec.voiceagent",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "shortDescription": "Fully local voice AI agent",
    "longDescription": "A privacy-first voice assistant. Speech recognition, language model, speech synthesis and voice cloning all run on this Mac. No cloud APIs. Ships its own Python runtime, so no developer tools are required; model weights download on first use.",
    "resources": [
      "runtime/**/*"
    ]
  }
}
